      "msg": "Execute on an account with no state"
    },
    {
      "code": 4,
      "name": "WrongAccount",
      "msg": "Account is not the PDA derived from (program, seed, keys)"
    },
    {
      "code": 5,
      "name": "InvalidConfig",
      "msg": "Violates the config invariants (empty or >MAX_MEMBERS, bad or duplicate key, perms 0 or outside ALL_PERMS, time_lock above MAX_TIME_LOCK, threshold 0 or above the VOTE count, no INITIATE or EXECUTE member, limit with threshold 0 or above the SPEND count or period 0)"
    },
    {
      "code": 6,
      "name": "BelowThreshold",
      "msg": "Fewer approvals than the threshold"
    },
    {
      "code": 7,
      "name": "UnsortedSigners",
      "msg": "Approvals not in strictly ascending member index order"
    },
    {
      "code": 8,
      "name": "NotMember",
      "msg": "Signer index (or removed key) is not a member"
    },
    {
      "code": 9,
      "name": "MissingPermission",
      "msg": "Member lacks the permission bit the role needs"
    },
    {
      "code": 10,
      "name": "BadSignature",
      "msg": "BIP-340 signature does not verify over the recomputed digest"
    },
    {
      "code": 11,
      "name": "AuthorityOnForeignAccount",
      "msg": "with_authority call targets an account other than the multisig"
    },
    {
      "code": 12,
      "name": "Reentry",
      "msg": "Action::Call targets this program"
    },
    {
      "code": 13,
      "name": "Overflow",
      "msg": "nonce, config_epoch, spend counter or time arithmetic overflow"
    },
    {
      "code": 14,
      "name": "UnsupportedVersion",
      "msg": "State version is not VERSION (a v1 state is rejected, not migrated)"
    },
    {
      "code": 15,
      "name": "TimeLockMismatch",
      "msg": "Immediate Execute of a non-Cancel action under a time lock, or Queue without one"
    },
    {
      "code": 16,
      "name": "QueueOccupied",
      "msg": "The queue slot holds an entry that has not expired before t"
    },
    {
      "code": 17,
      "name": "NotQueued",
      "msg": "Nothing queued, or the queued digest does not match (other action, nonce or epoch)"
    },
    {
      "code": 18,
      "name": "BadWindow",
      "msg": "Empty validity window (t + time_lock >= expiry, or the timestamp window is invalid)"
    },
    {
      "code": 19,
      "name": "NoLimit",
      "msg": "Spend without a spending limit"
    },
    {
      "code": 20,
      "name": "OverLimit",
      "msg": "Spend would exceed the limit amount in this period"
    },
    {
      "code": 21,
      "name": "StalePeriod",
      "msg": "Spend period p is before the current spend period"
    },
    {
      "code": 22,
      "name": "QueuerNotProposer",
      "msg": "Queue by a member other than the proposer (approvers do not sign t; only the proposer picks it)"
    }
  ],
