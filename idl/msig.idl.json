              "defined": "Tuple_NullifierPublicKey_ViewingPublicKey"
            }
          }
        }
      ],
      "execution": {
        "public": true,
        "private_owned": false
      },
      "variant": "Create",
      "variant_index": 0,
      "doc": "Root -> multisig actor (V, P). Initialises state; V must equal the PDA derived from seed = sha256(pad32('LEZ-MSIG/v1/seed') || sha256(borsh(cfg)) || salt) under this program (for_public_pda, or for_private_pda with keys). The seed is computed from cfg, not a plain argument path, so no `pda` seeds are listed."
    },
    {
      "name": "execute",
      "accounts": [
        {
          "name": "multisig",
          "writable": true,
          "signer": false,
          "init": false,
          "visibility": [
            "public",
            "private_pda"
          ]
        }
      ],
      "args": [
        {
          "name": "action",
          "type": {
            "defined": "Action"
          }
        },
        {
          "name": "expiry",
          "type": "u64"
        },
        {
          "name": "proposer",
          "type": {
            "defined": "Sig"
          }
        },
        {
          "name": "approvals",
          "type": {
            "vec": {
              "defined": "Sig"
            }
          }
        },
        {
          "name": "executor",
          "type": {
            "defined": "Sig"
          }
        }
      ],
      "execution": {
        "public": true,
        "private_owned": false
      },
      "variant": "Execute",
      "variant_index": 1,
      "doc": "Root -> multisig actor (V, P). Immediate execution: proposer, >= threshold approvals (strictly ascending index), executor, each BIP-340 over the digests of docs/ARCHITECTURE.md 2.4. Valid while timestamp < expiry. Bumps nonce; Config also bumps config_epoch. Under a time lock only Cancel executes immediately."
    },
    {
      "name": "queue",
      "accounts": [
        {
          "name": "multisig",
          "writable": true,
          "signer": false,
          "init": false,
          "visibility": [
            "public",
            "private_pda"
          ]
        }
      ],
      "args": [
        {
          "name": "action",
          "type": {
            "defined": "Action"
          }
        },
        {
          "name": "expiry",
          "type": "u64"
        },
        {
          "name": "t",
          "type": "u64"
        },
        {
          "name": "proposer",
          "type": {
            "defined": "Sig"
          }
        },
        {
          "name": "approvals",
          "type": {
            "vec": {
              "defined": "Sig"
            }
          }
        },
        {
          "name": "queuer",
          "type": {
            "defined": "Sig"
          }
        }
      ],
      "execution": {
        "public": true,
        "private_owned": false
      },
      "variant": "Queue",
      "variant_index": 2,
      "doc": "Root -> multisig actor (V, P). Starts the time lock: the Execute quorum (proposer, >= threshold approvals) plus the proposer's own /queue signature over body || t (queuer index = proposer index). Valid while timestamp < t (and >= the old entry's expiry if the slot is taken); needs time_lock != 0 and t + time_lock < expiry. Stores the /queue digest in the single queue slot."
    },
    {
      "name": "execute_queued",
      "accounts": [
        {
          "name": "multisig",
          "writable": true,
          "signer": false,
          "init": false,
          "visibility": [
            "public",
            "private_pda"
          ]
        }
      ],
      "args": [
        {
          "name": "action",
          "type": {
            "defined": "Action"
          }
        },
        {
          "name": "executor",
          "type": {
            "defined": "Sig"
          }
        }
      ],
      "execution": {
        "public": true,
        "private_owned": false
      },
      "variant": "ExecuteQueued",
      "variant_index": 3,
      "doc": "Root -> multisig actor (V, P). Executes the queued action: an EXECUTE member's /execute signature over body(queued.expiry) || queued.t; the action must hash to the queued digest. Valid in [t + time_lock, expiry). Bumps nonce, clears the slot."
    },
    {
      "name": "spend",
      "accounts": [
        {
          "name": "multisig",
          "writable": true,
          "signer": false,
          "init": false,
          "visibility": [
            "public",
            "private_pda"
          ]
        }
      ],
      "args": [
        {
          "name": "to",
          "type": {
            "defined": "AccountId"
          }
        },
        {
          "name": "amount",
          "type": "u128"
        },
        {
          "name": "p",
          "type": "u64"
        },
        {
          "name": "signers",
          "type": {
            "vec": {
              "defined": "Sig"
            }
          }
        }
      ],
      "execution": {
        "public": true,
        "private_owned": false
      },
      "variant": "Spend",
      "variant_index": 4,
      "doc": "Root -> multisig actor (V, P). Native transfer V -> to under the spending limit: >= limit.threshold SPEND members (strictly ascending index) sign /spend over epoch || spend.nonce || p || to || amount. Valid in [p*period, (p+1)*period). No proposal, no time lock; does not touch the action nonce."
    }
  ],
